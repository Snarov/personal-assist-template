# Copy to relay.env on the host. Do not commit the real file.
# deploy.sh writes chat id, bind, port, state path, and CURSOR_ENV_NAME
# from catalog.json → telegram and deploy. It does not overwrite this file
TELEGRAM_ALLOWED_CHAT_IDS=
RELAY_SECRET=replace-with-long-random
RELAY_BIND=127.0.0.1
RELAY_PORT=8787
RELAY_STATE_PATH=/var/lib/personal-assist/state.json
# Seconds to wait before starting another telegram-feedback agent while inbox
# still has unacked messages. Several voice replies in one burst share one run.
# RELAY_LAUNCH_COOLDOWN_SEC=360
# Identical /send text within this many seconds is not posted to Telegram again.
# A client timeout retries the same diary body; the first call often already landed.
# RELAY_SEND_DEDUPE_SEC=900
# Cursor launch. Need at least one of: webhook automation OR Cloud Agents API key.
# Webhook: cursor.com/automations → Telegram feedback → copy URL + Generate auth header.
# CURSOR_WEBHOOK_URL=https://api2.cursor.sh/automations/webhook/<id>
# CURSOR_WEBHOOK_KEY=crsr_...
# API fallback (Dashboard → API Keys). Used when the webhook is empty or returns non-2xx.
# Also required to auto-archive finished ritual chats (утро / вечер / telegram-feedback)
# so they leave the Agents sidebar. The internal cursor-cloud MCP cannot archive.
# CURSOR_API_KEY=
# CURSOR_ENV_NAME=Personal Assist
# CURSOR_ARCHIVE_IDLE=1
# CURSOR_ARCHIVE_INTERVAL_SEC=120
# CURSOR_ARCHIVE_NAME_SUBSTR=telegram feedback,morning check-in,evening review
# Voice: local faster-whisper on the host (same as Hermes). Language is ru.
# STT_LOCAL_MODEL=base
# Optional fallback if local STT fails: OPENAI_API_KEY + OPENAI_BASE_URL
