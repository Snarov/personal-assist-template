{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "routine/work-routine.spec.json",
  "id": "work-routine",
  "title": "Рабочая рутина вне фокус-задач",
  "version": "1.1.0",
  "locale": "ru",
  "timezone": "Europe/Moscow",
  "purpose": "Ежедневно учитывать обычную работу вне задач Personal OS: что было сделано, сколько времени заняло и насколько отвлекло от основных целей. Одна оценка.",
  "storage": {
    "spec": "routine/work-routine.spec.json",
    "dayEntry": "routine/entries/YYYY-MM-DD.json"
  },
  "scales": {
    "distraction": {
      "minimum": 1,
      "maximum": 3,
      "anchors": {
        "1": "почти не отвлекло от фокус-задач",
        "2": "заметно отвлекло или сократило время на фокус",
        "3": "сильно вытеснило или сорвало фокус"
      }
    }
  },
  "legacy": "specVersion 1.0.0 хранит energyDrain 1–3. С 1.1.0 это поле не пишется и не спрашивается: оно совпадало с distraction. Старые файлы не переписывать.",
  "agentRules": [
    "Рутина — обычная работа вне фокус-задач, которые отслеживаются в Notion.",
    "Не переносить фокус-задачу в рутину, если владелец сам не назвал её рутинной работой.",
    "Не выдумывать проект, содержание работы, минуты или оценки.",
    "Если владелец дал только общее время для нескольких дел, хранить их одним activity и не придумывать разбивку.",
    "Спрашивать одну оценку: насколько отвлекло, 1–3. Сколько сил забрало не спрашивать и в новую запись не писать.",
    "Если рутины явно не было, записать status=none, activities=[], totalMinutes=0, distraction=null. Ключ energyDrain не писать.",
    "Отсутствие ответа не означает, что рутины не было: файл не создавать или оставить partial."
  ],
  "schema": {
    "$anchor": "RoutineDayEntry",
    "$defs": {
      "weekday": {
        "type": "string",
        "enum": ["пн", "вт", "ср", "чт", "пт", "сб", "вс"]
      },
      "activity": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "minutes"],
        "properties": {
          "project": {
            "type": ["string", "null"],
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "minutes": {
            "type": ["integer", "null"],
            "minimum": 1
          }
        }
      }
    },
    "type": "object",
    "additionalProperties": false,
    "required": [
      "spec",
      "specVersion",
      "date",
      "weekday",
      "status",
      "activities",
      "totalMinutes",
      "distraction",
      "source"
    ],
    "properties": {
      "spec": {
        "const": "work-routine"
      },
      "specVersion": {
        "enum": ["1.0.0", "1.1.0"]
      },
      "date": {
        "type": "string",
        "format": "date"
      },
      "weekday": {
        "$ref": "#/$defs/weekday"
      },
      "status": {
        "type": "string",
        "enum": ["none", "partial", "complete"]
      },
      "activities": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/activity"
        }
      },
      "totalMinutes": {
        "type": ["integer", "null"],
        "minimum": 0
      },
      "distraction": {
        "type": ["integer", "null"],
        "minimum": 1,
        "maximum": 3
      },
      "energyDrain": {
        "type": ["integer", "null"],
        "minimum": 1,
        "maximum": 3
      },
      "source": {
        "type": "string",
        "minLength": 1
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "status": {
              "const": "none"
            }
          }
        },
        "then": {
          "properties": {
            "activities": {
              "maxItems": 0
            },
            "totalMinutes": {
              "const": 0
            },
            "distraction": {
              "const": null
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "status": { "const": "none" },
            "specVersion": { "const": "1.0.0" }
          },
          "required": ["status", "specVersion"]
        },
        "then": {
          "properties": {
            "energyDrain": { "const": null }
          },
          "required": ["energyDrain"]
        }
      },
      {
        "if": {
          "properties": { "specVersion": { "const": "1.1.0" } },
          "required": ["specVersion"]
        },
        "then": {
          "properties": { "energyDrain": false }
        }
      },
      {
        "if": {
          "properties": {
            "status": {
              "const": "complete"
            }
          }
        },
        "then": {
          "properties": {
            "activities": {
              "minItems": 1,
              "items": {
                "allOf": [
                  {
                    "$ref": "#/$defs/activity"
                  },
                  {
                    "properties": {
                      "minutes": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                ]
              }
            },
            "totalMinutes": {
              "type": "integer",
              "minimum": 1
            },
            "distraction": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "status": { "const": "complete" },
            "specVersion": { "const": "1.0.0" }
          },
          "required": ["status", "specVersion"]
        },
        "then": {
          "required": ["energyDrain"],
          "properties": {
            "energyDrain": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            }
          }
        }
      }
    ]
  }
}
